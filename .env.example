# Smart Timetable Local Environment Configuration
# Copy this file to .env and fill in your Firebase details.

# 1. Firebase API Key (from Firebase Console Project Settings -> General -> Web API Key)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# 2. Firebase Server Key (Optional, for FCM push notifications)
FCM_SERVER_KEY=your_fcm_server_key_here

# 3. Firebase Private Key Credentials JSON (Paste the entire content of firebase_key.json as a single-line string here if you run on Render)
# For local running, the app will automatically fall back to reading the "firebase_key.json" file if this variable is empty.
FIREBASE_CRED=
